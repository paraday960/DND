# ===== تلگرام =====
# توکن ربات را از @BotFather بگیرید
BOT_TOKEN=123456789:ABCdefGHI...

# ===== هوش مصنوعی (یکی را پر کنید — همه رایگان) =====
# گزینه ۱: میسترال (https://console.mistral.ai → API Keys — پلن Experiment رایگان)
AI_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-key
MISTRAL_MODEL=mistral-small-latest

# گزینه ۲: گوگل جمینی  (https://aistudio.google.com/apikey)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# گزینه ۳: گروک  (https://console.groq.com/keys)
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# گزینه ۴: اوپن‌روتر  (https://openrouter.ai/keys — مدل‌های free)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# ===== تنظیمات بازی =====
MAX_PLAYERS=8

# ===== مینی‌گیم (Telegram Mini App) =====
# روی گوشی: termux/tunnel.sh را اجرا کن — آدرس خودکار می‌شود.
# اگر سرور دیگری داری، آدرس HTTPS را اینجا بگذار:
# WEBAPP_URL=https://your-domain.com
# پورت وب‌سرور مینی‌گیم:
PORT=8080
# حالت آزمایشی (۱) — بدون تلگرام هم با کاربر آزمایشی کار می‌کند. برای تست:
WEBAPP_DEV=0
